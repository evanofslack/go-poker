PORT=8080
# extra origins allowed to open websockets, comma separated
# ALLOWED_ORIGINS=http://localhost:3000
# directory of the built frontend (defaults to /app/out in the docker image)
# STATIC_DIR=../web/out

# limits; durations use go syntax (90s, 30m, 1h)
# MAX_TABLES=100              # tables open at once
# MAX_TABLES_PER_IP=3         # open tables created from one address
# MAX_CONNS=1000              # websocket connections in total
# MAX_CONNS_PER_IP=10         # websocket connections from one address
# MAX_MESSAGES_PER_SECOND=20  # a connection sending more is closed
# RECONNECT_GRACE=60s         # how long a disconnected player keeps their seat
# ENDED_TABLE_TTL=1h          # how long a table stays readable after its session ends
# IDLE_TABLE_TIMEOUT=30m      # close a table after this long without a player action
# take client addresses from X-Forwarded-For; only behind a proxy that sets it
# TRUST_PROXY=false
